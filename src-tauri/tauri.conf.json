{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudentOS",
  "version": "0.1.0",
  "identifier": "io.github.jacy864.studentos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StudentOS",
        "width": 1240,
        "height": 900,
        "minWidth": 400,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["TradChinese", "SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
